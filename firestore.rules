rules_version = '2';

// MoorTaalim - Firestore Security Rules
//
// A coller dans Firebase Console > Firestore Database > Rules
// (ou deployer avec `firebase deploy --only firestore:rules` si vous
// utilisez le Firebase CLI).
//
// Contexte : l'app authentifie tous les utilisateurs, y compris de facon
// anonyme (signInAnonymously), donc request.auth != null est toujours vrai
// pour un utilisateur legitime de l'app. Ces regles s'appuient sur cette
// authentification pour restreindre l'acces aux seules donnees possedees
// par l'utilisateur qui fait la requete.
//
// Le panneau d'administration (projet moortaalim_admin) se connecte avec un
// compte Google ; seuls les emails listes dans isAdmin() y ont acces.
// Pour ajouter un admin : ajouter son email ici ET dans
// moortaalim_admin/lib/config.dart.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'jalalmtsk@gmail.com',
          'mtsacedoce@gmail.com'
        ];
    }

    // Le 1er profil enfant utilise le document "<uid>", les suivants
    // "<uid>_p2", "<uid>_p3"... (ProfileStore.cloudDocId).
    function ownsUserDoc(docId) {
      return request.auth != null
        && (docId == request.auth.uid
            || docId.matches(request.auth.uid + '_.+'));
    }

    // ── users/{docId} ────────────────────────────────────────────────────
    // Chaque utilisateur ne peut lire/ecrire QUE ses propres documents.
    // "isLocked" et "adsEnabled" sont des champs controles par l'admin
    // (banissement, activation des pubs) : un client ne doit jamais pouvoir
    // les modifier lui-meme, meme en ecrivant son propre document.
    match /users/{docId} {
      allow read: if ownsUserDoc(docId) || isAdmin();

      allow create: if isAdmin() || (ownsUserDoc(docId)
        && !('isLocked' in request.resource.data)
        && !('adsEnabled' in request.resource.data));

      allow update: if isAdmin() || (ownsUserDoc(docId)
        // Interdit toute tentative de modifier isLocked/adsEnabled depuis
        // le client, meme si ces champs existent deja sur le document.
        && !request.resource.data.diff(resource.data)
              .affectedKeys().hasAny(['isLocked', 'adsEnabled']));

      allow delete: if isAdmin();
    }

    // ── app_settings/{doc} ───────────────────────────────────────────────
    // notification + version : lus par l'app (NotificationManager,
    // UpdateChecker), ecrits uniquement depuis le panneau admin.
    match /app_settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── backups/{code} ───────────────────────────────────────────────────
    // Le code de sauvegarde EST le secret (10 caracteres aleatoires,
    // ~3x10^17 combinaisons). On exige d'etre authentifie (anonyme ou non)
    // pour lire un code precis / le supprimer. Le LISTAGE de la collection
    // est reserve a l'admin : sinon n'importe quel utilisateur pourrait
    // enumerer tous les codes et restaurer les donnees d'un autre enfant.
    //
    // Pour un niveau de securite supplementaire, activez App Check sur ce
    // projet Firebase : cela bloque les appels qui ne viennent pas d'une
    // build authentique de l'app.
    match /backups/{code} {
      allow get, delete: if request.auth != null;
      allow list: if isAdmin();
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if false; // un backup est cree puis supprime, jamais modifie
    }
  }
}
